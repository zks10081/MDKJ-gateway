<UserControl
    x:Class="getway.Controls.ProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="70"
    d:DesignWidth="70"
    mc:Ignorable="d">
    <Grid>
        <ItemsControl ItemsSource="{Binding MarkList, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding Angle}" />
                        </Grid.RenderTransform>
                        <Border
                            Width="2"
                            Height="7"
                            VerticalAlignment="Top"
                            Background="{Binding Color}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Border Margin="5" CornerRadius="1000">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Offset="0.2" Color="#2249E3E8" />
                        <GradientStop Offset="0.9" Color="#0D49E3E8" />
                        <GradientStop Offset="2" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center">
                    <Run
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{Binding ForeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Run
                        FontSize="9"
                        Foreground="#888"
                        Text="%" />
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="9"
                    Foreground="#888"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
