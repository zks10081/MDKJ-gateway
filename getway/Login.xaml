<Window
    x:Class="getway.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="登录"
    Width="300"
    Height="300"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#072748" />
            <GradientStop Offset="0.5" Color="#0c3e6e" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="BanButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource iconfont}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style
            x:Key="CloseButton"
            BasedOn="{StaticResource BanButton}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="9*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="&#xe629;" Style="{StaticResource BanButton}" />
                <Button Content="&#xe654;" Style="{StaticResource CloseButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel />

        </Grid>


    </Grid>
</Window>
