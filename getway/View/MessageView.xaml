<Window
    x:Class="getway.View.MessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MessageView"
    Height="240"
    MinWidth="300"
    MaxWidth="620"
    ResizeMode="NoResize"
    SizeToContent="Width"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <!--  CaptionHeight 对应标题栏行高，整窗可拖动；按钮用 IsHitTestVisibleInChrome 收回点击权  -->
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="1"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#072748" />
            <GradientStop Offset="0.5" Color="#0c3e6e" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="#FFA500" />
                <Setter Property="Foreground" Value="#072748" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#FFB84D" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E09200" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>


    </Window.Resources>

    <Border BorderBrush="#2D7FF9" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <!--  标题栏  -->
            <Grid Grid.Row="0" Background="#002F54">
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryText}"
                    Text="提示弹窗" />
            </Grid>

            <Grid
                Grid.Row="1"
                Width="auto"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="{Binding MsgTitle}" />

                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1*" />

                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    BorderBrush="LightGray"
                    BorderThickness="0,2"
                    CornerRadius="0">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,2,15,0"
                            FontFamily="{StaticResource iconfont}"
                            FontSize="24"
                            Foreground="{Binding IconColor}"
                            Text="{Binding IconText}" />
                        <TextBlock
                            MaxWidth="420"
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding Info}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Width="80"
                            Height="30"
                            Margin="5,0"
                            Background="Orange"
                            Click="OkButton_Click"
                            Content="确定"
                            Style="{StaticResource ButtonStyle}"
                            Visibility="{Binding OkShow}" />
                        <Button
                            Width="80"
                            Height="30"
                            Margin="5,0"
                            Background="LightGray"
                            Click="CancelButton_Click"
                            Content="取消"
                            Style="{StaticResource ButtonStyle}"
                            Visibility="{Binding CanclShow}" />
                    </StackPanel>
                </Grid>

            </Grid>

        </Grid>
    </Border>
</Window>
