<Window
    x:Class="getway.View.EditorSipUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EditorSipUserView"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <!--  CaptionHeight 对应标题栏行高，整窗可拖动；按钮用 IsHitTestVisibleInChrome 收回点击权  -->
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#072748" />
            <GradientStop Offset="0.5" Color="#0c3e6e" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/style/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <!--  标题栏  -->
        <Grid Grid.Row="0" Background="#002F54">
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource SecondaryText}"
                Text="Sip用户信息-配置热线" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Click="CloseButton_Click"
                    Content="&#xe654;"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                FontFamily="{StaticResource tihei}"
                FontSize="32"
                Foreground="White"
                Text="SIP用户信息" />
        </Grid>

        <Grid
            Grid.Row="2"
            Width="500"
            VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Style="{StaticResource InputPanel}">
                    <TextBlock
                        FontSize="24"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="板卡端口" />
                    <Border Width="300" Style="{StaticResource InputBoxStyle}">
                        <TextBox
                            x:Name="txtFSP"
                            GotKeyboardFocus="Input_GotKeyboardFocus"
                            Style="{StaticResource FlatInputStyle}"
                            TabIndex="0"
                            Text="{Binding FSP, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
                <StackPanel Style="{StaticResource InputPanel}">
                    <TextBlock
                        FontSize="24"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="用户号码" />
                    <Border Style="{StaticResource InputBoxStyle}">
                        <TextBox
                            x:Name="txtUserPhone"
                            GotKeyboardFocus="Input_GotKeyboardFocus"
                            Style="{StaticResource FlatInputStyle}"
                            TabIndex="0"
                            Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
                <StackPanel Style="{StaticResource InputPanel}">
                    <TextBlock
                        FontSize="24"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="热线号码" />
                    <Border Style="{StaticResource InputBoxStyle}">
                        <TextBox
                            x:Name="txtHotLinePhone"
                            GotKeyboardFocus="Input_GotKeyboardFocus"
                            Style="{StaticResource FlatInputStyle}"
                            TabIndex="0"
                            Text="{Binding HotLinePhone, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
                <StackPanel Style="{StaticResource InputPanel}">
                    <TextBlock
                        FontSize="24"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="热线时间" />
                    <Border Style="{StaticResource InputBoxStyle}">
                        <TextBox
                            x:Name="txtHotLineTime"
                            GotKeyboardFocus="Input_GotKeyboardFocus"
                            Style="{StaticResource FlatInputStyle}"
                            TabIndex="0"
                            Text="{Binding HotLineTime, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Foreground="White"
                    Text="{Binding ActionContent}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Button
                    Width="100"
                    Margin="0,5,40,5"
                    HorizontalAlignment="Left"
                    Background="#9896f1"
                    Command="{Binding CheckLineCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                    Content="检测线路"
                    IsEnabled="{Binding IsEdit}"
                    Style="{StaticResource LoginButtonStyle}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="40,5,40,5"
                    Background="Orange"
                    Command="{Binding EditSipUserHotline}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                    Content="修改"
                    IsEnabled="{Binding IsEdit}"
                    Style="{StaticResource LoginButtonStyle}" />
                <Button
                    Width="100"
                    Margin="40,5,0,5"
                    Background="LightGray"
                    Command="{Binding Cancel}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                    Content="取消"
                    IsEnabled="{Binding IsEdit}"
                    Style="{StaticResource LoginButtonStyle}" />
            </StackPanel>

        </Grid>

    </Grid>
</Window>
