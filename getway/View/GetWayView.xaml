<UserControl
    x:Class="getway.View.GetWayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="930"
    d:DesignWidth="1500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  面板标题栏  -->
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#005788" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="PanelHeaderIcon" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource iconfont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="StatusDescText" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#b8c8d8" />
        </Style>

        <!--  面板内容区  -->
        <Style x:Key="PanelBody" TargetType="Border">
            <Setter Property="Background" Value="#0E3F68" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!--  操作按钮  -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#1F6FA8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource iconfont}"
                                    FontSize="14"
                                    Text="{TemplateBinding Tag}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--  触发器  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCFFA500" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  命令输入框  -->
        <Style x:Key="CommandInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="#0E3F68" />
            <Setter Property="BorderBrush" Value="#2C7BB5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  网关列表项  -->
        <Style x:Key="GatewayItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            Name="itemBorder"
                            Height="30"
                            Margin="3,2"
                            Background="Transparent"
                            CornerRadius="4">
                            <ContentPresenter Margin="8,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#CCFFA500" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource tihei}"
            FontSize="36"
            FontWeight="Bold"
            Foreground="#FFFFFF"
            Text="语音网关管理系统" />

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />

            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="tbTime"
                    FontFamily="{StaticResource tihei}"
                    FontSize="24"
                    Style="{StaticResource PanelHeaderText}"
                    Text="2000-1-1 0:00:00" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="10"
                    Height="10"
                    Background="Green"
                    CornerRadius="1000" />
                <TextBlock
                    FontSize="24"
                    Style="{StaticResource PanelHeaderText}"
                    Text="IP 电话用户" />
            </StackPanel>
            <Border
                Grid.Column="2"
                Margin="0,0"
                Padding="10,5"
                HorizontalAlignment="Right"
                Style="{StaticResource PanelBody}">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="10"
                        Height="10"
                        Background="#87ceff"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Foreground="#4A3500" Text="空闲" />
                    <Border
                        Width="10"
                        Height="10"
                        Background="#ffff00"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Text="振铃" />
                    <Border
                        Width="10"
                        Height="10"
                        Background="#90ee90"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Text="通话" />
                    <Border
                        Width="10"
                        Height="10"
                        Background="#ffc0cb"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Text="摘机" />
                    <Border
                        Width="10"
                        Height="10"
                        Background="#bebebe"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Text="离线" />
                    <Border
                        Width="10"
                        Height="10"
                        Background="#213740"
                        CornerRadius="1000" />
                    <TextBlock Style="{StaticResource StatusDescText}" Text="锁机" />
                </StackPanel>
            </Border>

        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!--  网关ip列表  -->
            <Grid Grid.Column="0" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="10" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xe64f;" />
                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="网关列表" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    ClipToBounds="True"
                    Style="{StaticResource PanelBody}">
                    <ListBox
                        d:ItemsSource="{d:SampleData ItemCount=5}"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource GatewayItemStyle}"
                        ItemsSource="{Binding GetWayList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedValue="{Binding GetWayIp}"
                        SelectedValuePath="IP">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource iconfont}"
                                        FontSize="12"
                                        Foreground="White"
                                        Text="&#xe67d;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource tihei}"
                                        FontSize="12"
                                        Foreground="White"
                                        Text="{Binding IP}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!--  ipc电话内容  -->
            <Grid Grid.Column="1" Margin="10,0">

                <Border Background="Transparent" CornerRadius="5">
                    <local:IpcItemView DataContext="{Binding IpcItemVM}" />
                </Border>
            </Grid>

            <!--  操作控制  -->
            <Grid Grid.Column="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelHeader}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xe626;" />
                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="操作控制" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,2,0,0">
                    <Button
                        Command="{Binding AddConnectCommand}"
                        Content="连接"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                    <Button
                        Command="{Binding QueryBoardCommand}"
                        Content="查询板子"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                    <Button
                        Command="{Binding QuerySIPUserCommand}"
                        Content="查询sip用户"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                    <TextBox Style="{StaticResource CommandInputStyle}" Text="{Binding AnyCommandString}" />
                    <Button
                        Margin="0"
                        Command="{Binding QueryCommand}"
                        Content="执行命令"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                    <Button
                        Command="{Binding AddGetwayCommand}"
                        Content="添加网关"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                    <Button
                        Command="{Binding DeleteGetwayCommand}"
                        Content="删除网关"
                        Style="{StaticResource ButtonStyle}"
                        Tag="&#xe626;" />
                </StackPanel>

                <Border Grid.Row="4" Style="{StaticResource PanelHeader}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PanelHeaderIcon}" Text="&#xe64f;" />
                        <TextBlock Style="{StaticResource PanelHeaderText}" Text="命令回显" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="6"
                    ClipToBounds="True"
                    Style="{StaticResource PanelBody}">
                    <ScrollViewer
                        Margin="6"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#DCEBF7"
                            Text="{Binding ReadContent}"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
