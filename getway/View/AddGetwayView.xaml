<Window
    x:Class="getway.View.AddGetwayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AddGetwayView"
    Width="800"
    Height="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <!--  CaptionHeight 对应标题栏行高，整窗可拖动；按钮用 IsHitTestVisibleInChrome 收回点击权  -->
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#072748" />
            <GradientStop Offset="0.5" Color="#0c3e6e" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/style/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <!--  标题栏  -->
        <Grid Grid.Row="0" Background="#002F54">
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource SecondaryText}"
                Text="网关系统-添加" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    Click="CloseButton_Click"
                    Content="&#xe654;"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Width="400"
            VerticalAlignment="Bottom">
            <StackPanel>
                <TextBlock
                    FontSize="24"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="网关IP" />
                <Border Style="{StaticResource InputBoxStyle}">
                    <TextBox
                        x:Name="txtUser"
                        GotKeyboardFocus="Input_GotKeyboardFocus"
                        Style="{StaticResource FlatInputStyle}"
                        TabIndex="0"
                        Text="{Binding GetwayIp, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="0,5,40,5"
                    Background="Orange"
                    Command="{Binding AddGetWayCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                    Content="添加"
                    Style="{StaticResource LoginButtonStyle}" />
                <Button
                    Width="100"
                    Margin="40,5,0,5"
                    Background="LightGray"
                    Command="{Binding ColseGetWay}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                    Content="取消"
                    Style="{StaticResource LoginButtonStyle}" />
            </StackPanel>

        </Grid>

    </Grid>
</Window>
