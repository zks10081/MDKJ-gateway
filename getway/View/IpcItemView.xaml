<UserControl
    x:Class="getway.View.IpcItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:getway.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="744"
    d:DesignWidth="936"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  状态胶囊：背景画在 Border 上，才会真正显示成色块  -->
        <!--  配色原则：底色饱和、文字按底色明度切换深/浅，保证任何状态下都清晰  -->
        <!--  状态色与 DefaulConfig 中的 SIPUserBackgroundColorOf* 一一对应  -->
        <Style x:Key="ItemStatus" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Name="StatusBorder"
                            MinWidth="50"
                            Margin="0,3,0,0"
                            Padding="8,2"
                            HorizontalAlignment="Center"
                            Background="{Binding BackgroundColor}"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                Name="StatusText"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="● 未知" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  0 离线：灰蓝底 + 白字  -->
                            <DataTrigger Binding="{Binding Status}" Value="0">
                                <Setter TargetName="StatusText" Property="Foreground" Value="White" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 离线" />
                            </DataTrigger>
                            <!--  1 振铃：琥珀黄底（亮）+ 深字  -->
                            <DataTrigger Binding="{Binding Status}" Value="1">
                                <Setter TargetName="StatusText" Property="Foreground" Value="#3A2A00" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 振铃" />
                            </DataTrigger>
                            <!--  2 摘机：玫粉底（亮）+ 深字  -->
                            <DataTrigger Binding="{Binding Status}" Value="2">
                                <Setter TargetName="StatusText" Property="Foreground" Value="#4A0D22" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 摘机" />
                            </DataTrigger>
                            <!--  3 通话中：正红底 + 白字  -->
                            <DataTrigger Binding="{Binding Status}" Value="3">
                                <Setter TargetName="StatusText" Property="Foreground" Value="White" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 通话" />
                            </DataTrigger>
                            <!--  4 锁定：深橙棕底 + 白字  -->
                            <DataTrigger Binding="{Binding Status}" Value="4">
                                <Setter TargetName="StatusText" Property="Foreground" Value="White" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 锁机" />
                            </DataTrigger>
                            <!--  5 空闲：绿底 + 白字  -->
                            <DataTrigger Binding="{Binding Status}" Value="5">
                                <Setter TargetName="StatusText" Property="Foreground" Value="White" />
                                <Setter TargetName="StatusText" Property="Text" Value="● 空闲" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="borderStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ToolTip" Value="{Binding BorderName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!--  背景画在模板内的 Border 上，触发器必须带 TargetName 才能改到它  -->
                            <Border
                                x:Name="PART_Background"
                                Background="#1F6FA8"
                                BorderBrush="#2C7BB5"
                                BorderThickness="1"
                                CornerRadius="5,5,0,0" />
                            <StackPanel
                                Margin="20,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    x:Name="PART_Icon"
                                    Margin="5,7,0,5"
                                    FontFamily="{StaticResource iconfont}"
                                    FontSize="18"
                                    Foreground="White"
                                    Text="&#xe605;" />
                                <TextBlock
                                    x:Name="PART_Text"
                                    Margin="5"
                                    FontSize="18"
                                    Foreground="White"
                                    Text="{Binding BorderName}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Orange" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="12*" />
            <RowDefinition Height="10" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  WrapPanel + ItemWidth/ItemHeight：列数随中间栏宽度自动增减，纵向滚动  -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                Margin="6"
                d:ItemsSource="{d:SampleData ItemCount=64}"
                ItemsSource="{Binding IpcUserList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemHeight="112" ItemWidth="112" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding DataContext.EditchSipUserCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            CommandParameter="{Binding Name}">
                            <Grid
                                Width="104"
                                Height="104"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="2*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.RowSpan="3"
                                    Background="#14496F"
                                    BorderBrush="#2C7BB5"
                                    BorderThickness="1"
                                    CornerRadius="5" />

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource tihei}"
                                    FontSize="14"
                                    Foreground="#BBD9F0"
                                    Text="{Binding Name}" />

                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource iconfont}"
                                    FontSize="52"
                                    Foreground="{Binding BackgroundColor}"
                                    Text="&#xe600;" />

                                <!--  状态显示（在线/离线）  -->
                                <Button
                                    Grid.Row="2"
                                    Margin="0,0,0,5"
                                    Background="Transparent"
                                    Style="{StaticResource ItemStatus}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            CornerRadius="5">
            <Grid>
                <!--  M0 0 55 20 C60 22 60 25 60 30 L60 305 C60 310 60 313 55 315 L0 335  -->
                <Path
                    Margin="0"
                    Data=""
                    Fill="#3000"
                    Stretch="Fill">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.4" Color="Orange" />
                            <GradientStop Offset="0.6" Color="Orange" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!--  用 Grid 而不是 StackPanel：水平 StackPanel 会把 ListBox 压成内容宽度，无法均分  -->
                <Grid Margin="10,0">
                    <ListBox
                        HorizontalAlignment="Stretch"
                        d:ItemsSource="{d:SampleData ItemCount=4}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ItemsSource="{Binding BorderList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectBorder}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  Rows=1 + 自动列：板卡数量变化时也始终一行均分，不用给列数  -->
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <!--  容器必须与按钮一起禁用，否则 ListBoxItem 仍会被选中、仍有自带悬停/选中高亮  -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!--  固定宽度120  -->
                                <Setter Property="Width" Value="240" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <!--  ⭐ 核心：将数据对象的 IsEnable 绑定到容器的 IsEnabled  -->
                                <Setter Property="IsEnabled" Value="{Binding IsEnable}" />
                                <!--  去除默认焦点边框（按需保留）  -->
                                <!--  Setter Property="FocusVisualStyle" Value="{x:Null}" />  -->
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Bd"
                                                Margin="20,0"
                                                VerticalAlignment="Bottom"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="10,10,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!--  ✅ 正常选中高亮（IsEnabled=True 时生效）  -->
                                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0079b7" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#00def3" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#027fc1" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#00def3" />
                                                </Trigger>

                                                <!--  ✅ 禁用时：强制清除选中视觉效果  -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!--  宽度交给 UniformGrid 均分，这里只需拉伸并留边距  -->
                                <Button
                                    Margin="6,5"
                                    Padding="10,5"
                                    Command="{Binding DataContext.SelectBorderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource borderStyle}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

            </Grid>

        </Border>

    </Grid>
</UserControl>
