<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Font\iconfont.ttf" />
    <None Remove="Assets\Font\YouSheBiaoTiHei.ttf" />
    <None Remove="Assets\Image\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Font\iconfont.ttf" />
    <Resource Include="Assets\Font\YouSheBiaoTiHei.ttf" />
    <Resource Include="Assets\Image\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
